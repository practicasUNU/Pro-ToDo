# compiled output
/dist
/node_modules
/build

# Logs
# Anclado con `/`: sin la barra, el patron ignora CUALQUIER directorio llamado
# `logs` a cualquier profundidad, y eso se tragaba `src/modules/logs/` entero
# —el modulo de trazabilidad— dejandolo fuera del repositorio sin avisar.
#
# Y con `/*` —el CONTENIDO— en vez de `/logs` —el directorio—: git no desciende
# a un directorio excluido, asi que sobre `/logs` la negacion de abajo seria
# inerte y el `.gitkeep` nunca se versionaria. Mismo patron que `static/uploads`.
/logs/*
!/logs/.gitkeep
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Archivos estaticos servidos por ServeStaticModule.
# Se versiona el directorio (via .gitkeep) pero nunca los binarios que contiene:
# las imagenes de los articulos las sube el operador y no son codigo fuente.
/static/uploads/*
!/static/uploads/.gitkeep

# =============================================================================
# 1. SERVIDOR NESTJS
# =============================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:9000
ACCEPTED_EMAIL_DOMAINS=@gmail.com,@otrodominio.com,@partner.org

# =============================================================================
# 2. BASE DE DATOS (PostgreSQL vía Docker)
# =============================================================================
DB_HOST=localhost
DB_PORT=5433
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=protodo_db

# =============================================================================
# 3. SEGURIDAD (Auth OTP / Perímetro)
# =============================================================================
JWT_SECRET=super_secret_jwt_key_change_in_production
# Vigencia del access token. Corta a proposito: es un JWT autocontenido y no se
# puede revocar, asi que la sesion se sostiene rotando el refresh token.
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# Subredes CIDR autorizadas separadas por comas (perimetro de red, PROT-05).
# Ya NO es la fuente primaria: la tabla `allowed_ips` (gestionada en caliente desde
# el modulo ADMIN de IP Whitelist) manda mientras tenga registros. Esta variable solo
# se aplica como fallback de arranque cuando la tabla esta vacia (semillado seguro),
# junto con 127.0.0.1/32 y ::1/128 que siempre se permiten en ese caso.
ALLOWED_IP_RANGES=127.0.0.1/32,

# El secreto TOTP ya NO se deriva de una semilla maestra: cada cuenta guarda el
# suyo, aleatorio, en `usuarios.secreto_otp` (migracion 003). Por eso aqui no hay
# OTP_SECRET: el codigo dejo de leerla.
OTP_EXPIRATION_MINUTES=5

# =============================================================================
# 4. SECRETOS DE BUZÓN (IMAP) Y ENVÍO DE CORREOS (SMTP)
# =============================================================================
# Del entorno sale ÚNICAMENTE el secreto. Host, puerto, usuario, buzón, TLS y
# periodo de sondeo NO son variables de entorno: viajan en el payload JSON del
# nodo TRIGGER_IMAP (`params` jsonb de `flujos.configuracion_pipeline`), porque
# son configuración por flujo y no del servidor — dos flujos pueden vigilar dos
# buzones distintos en el mismo despliegue.
#
# El nodo solo guarda el NOMBRE de la variable en `passwordEnvKey`, nunca la
# contraseña. Ese nombre debe cumplir el patrón `IMAP_*PASSWORD` que impone
# `ImapTriggerConfigDto`: sin esa restricción, un EDITOR podría declarar
# `passwordEnvKey: JWT_SECRET` y hacer que el servidor enviase el secreto de
# firma de tokens a un host arbitrario como si fuera una clave de buzón.
#
# Añadir un buzón nuevo es añadir aquí otra variable `IMAP_<ALGO>_PASSWORD` y
# reiniciar Nest (`--watch` no recarga el `.env`).
IMAP_UNUWARE_PASSWORD="clave_aplicacion_16_caracteres"

# SMTP es independiente del nodo IMAP: lo consume `EmailService` para enviar los
# códigos OTP de autenticación, y sí es configuración del servidor.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Proto-Do Auth <no-reply@example.com>"

# =============================================================================
# 5. APIS DE NODOS ESPECIALIZADOS (LLM / CMS / Envío masivo)
# =============================================================================
CLAUDE_API_KEY=sk-ant-api-key-here
OPENAI_API_KEY=sk-openai-api-key-here

DRUPAL_API_BASE_URL=https://api.example.com/jsonapi
DRUPAL_API_TOKEN=your_drupal_oauth_or_bearer_token

ACENS_API_BASE_URL=https://api.acens.com/v1
ACENS_API_KEY=your_acens_api_token

# =============================================================================
# 6. TRAZABILIDAD Y ARCHIVOS DE LOG
# =============================================================================
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m

# =============================================================================
# 7. MOTOR FSM (Despacho manual y recursos estáticos)
# =============================================================================
# Prefijo base para imágenes y recursos estáticos. Se inyecta en las plantillas
# como el namespace sintético `_assets.base_url`, de modo que el HTML nunca
# incrusta el host: `<img src="{{_assets.base_url}}/{{parsed_email.image_path}}">`.
#
# Sirve el propio backend vía ServeStaticModule desde `backend/static/uploads/`,
# así que el puerto debe coincidir con PORT y la cola con el `serveRoot` de
# AppModule. Si algún día los estáticos se mueven a un CDN, esta es la única
# variable que hay que tocar: ninguna plantilla guardada lleva el host dentro.
ASSETS_BASE_URL=http://localhost:3000/static/uploads
# Concurrencia máxima de instancias activas por flujo (RNF-09). El índice único
# parcial `idx_flujo_activo` ya impone 1 a nivel de base de datos: subir este
# número no lo levanta, solo relaja la guarda previa del motor.
MAX_CONCURRENT_EXECUTIONS_PER_FLOW=1

# =============================================================================
# 8. DISPARADORES AUTOMÁTICOS (Sondeo IMAP)
# =============================================================================
# Interruptor maestro del sondeo periódico del nodo TRIGGER_IMAP.
#
# Deshabilitado por defecto A PROPÓSITO: el nodo marca los correos procesados
# con la bandera \Seen, así que arrancar el backend en una máquina de desarrollo
# apuntando al buzón real los consumiría y el entorno que sí debe procesarlos ya
# no los vería. El código exige el valor exacto "true", de modo que el fallo por
# omisión sea "no sondea".
#
# No basta con esta variable: cada flujo necesita además `flujos.activo = true`.
# Son dos interruptores en serie, uno global y otro por flujo.
IMAP_POLLING_ENABLED=false

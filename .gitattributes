# Finales de linea normalizados para que el repo funcione igual al clonar en
# Linux y en Windows (docs/INSTALACION_Y_ENTORNO.md). Ademas de `core.autocrlf`:
# estas reglas mandan sobre la configuracion local de cada desarrollador.

# Por defecto: Git detecta texto y lo guarda con LF en el indice.
* text=auto

# Se ejecutan en Linux o dentro de contenedores: un CR rompe el interprete
# (`/usr/bin/env: 'bash\r'`) o el parser de psql/Docker/Nginx.
*.sh         text eol=lf
*.sql        text eol=lf
Dockerfile*  text eol=lf
.dockerignore text eol=lf
*.conf       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
.env*        text eol=lf

# cmd.exe necesita CRLF: con LF las etiquetas de `goto`/`call` fallan al azar.
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binarios: sin conversion ni diff de texto.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.docx binary
*.pptx binary

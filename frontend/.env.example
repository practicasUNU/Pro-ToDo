# =============================================================================
# API DEL BACKEND (NestJS)
# =============================================================================
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ACCEPTED_EMAIL_DOMAINS=@gmail.com,@otrodominio.com,@partner.org

# Origen del canal WebSocket de eventos de ejecucion (NotificationGateway).
# OPCIONAL: si se deja sin declarar, el cliente toma el ORIGEN de
# VITE_API_BASE_URL —solo el esquema y el host, descartando el sufijo /api—,
# que es lo correcto mientras API y socket compartan servidor.
# Declararla solo hace falta cuando el socket vive en otro host o puerto.
# NUNCA apuntarla al puerto del servidor de desarrollo (9000): ahi no hay
# backend, Vite responde su index.html con 200 OK al sondeo de Socket.io y el
# cliente reintenta en bucle sin un solo error en consola. Debe apuntar al
# BACKEND. El cliente descarta el valor si coincide con el origen del documento.
# VITE_SOCKET_URL=http://localhost:5000
